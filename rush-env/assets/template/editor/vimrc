"====================================================
"=                   基础配置                       =
"====================================================

set nocompatible                                    " 去除vi一致性
set encoding=UTF-8

let data_dir = has('nvim') ? stdpath('data') . '/site' : '~/.vim'
if empty(glob(data_dir . '/autoload/plug.vim'))
  silent execute '!curl -fLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
  autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
endif

"====================================================
"=                   插件列表                       =
"====================================================
call plug#begin('~/plugged')

Plug 'terryma/vim-multiple-cursors'
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'preservim/nerdtree'
            \ | Plug 'xuyuanp/nerdtree-git-plugin'
            \ | Plug 'ryanoasis/vim-devicons'
Plug 'easymotion/vim-easymotion'                    " 智能跳转到单词
Plug 'luochen1990/rainbow'                          " 彩色括号
Plug 'mhinz/vim-startify'
Plug 'christoomey/vim-tmux-navigator'

" Plug 'sjl/vitality.vim'                           " (Vit)ality 是一个插件，可以让 (V)im 与 (i)Term 2 和 (t)mux 完美配合。

" Plug 'neoclide/coc.nvim', {'branch': 'release'}     " coc.vim
" Plug 'Shougo/neco-vim'
" Plug 'neoclide/coc-neco'
Plug 'neoclide/jsonc.vim'

Plug 'sbdchd/neoformat'

Plug 'lukas-reineke/indent-blankline.nvim'          " 彩色的indent对齐线

Plug 'sainnhe/everforest'
Plug 'catppuccin/vim', { 'as': 'catppuccin' }
Plug 'rose-pine/neovim', { 'as': 'rose-pine' }
"Plug 'tjdevries/colorbuddy.nvim'
"Plug 'BppleMan/monokai-soda.vim'
"Plug 'tanvirtin/monokai.nvim'

Plug 'rust-lang/rust.vim'
call plug#end()

"====================================================
"=                     常规设置                     =
"====================================================
syntax on
set number                                          "开启行号
set encoding=utf-8
set t_Co=256
set textwidth=120
set relativenumber                                  " 显示当前行行号,其它行则显示相对行号
set showmatch                                       " 高亮匹配的括号{[()]}
"set spell spelllang=en_us                          " 英语拼写检查
set autoread                                        " 自动读取文件在磁盘上的改动
filetype plugin indent on
set tabstop=4                                       " show existing tab with 4 spaces width
set shiftwidth=4                                    " when indenting with '>', use 4 spaces width
set expandtab                                       " On pressing tab, insert 4 spaces
set cursorline                                      " 高亮当前行
set cursorcolumn                                    " 高亮当前列
set wildmenu                                        " visual autocomplete for command menu
set hlsearch                                        " 搜索高亮匹配
"set foldenable                                     " 启用折叠
"set foldmethod=indent                              " 根据缩进折叠
set clipboard=unnamed                               " 默认使用系统剪贴板寄存器
set timeout                                         " 设置命令序列直接间隔的等待时间
set timeoutlen=200
set ttimeout
set ttimeoutlen=200
set bs=2                                            " 设置退格键可以删除空行
set guifont=JetBrainsMonoNerdFontComplete-Light:h18
let mapleader=","

"====================================================
"=                     插件设置                     =
"====================================================

" -------------------monokai-soda--------------------
let g:enable_bold_font=1
let g:enable_italic_font=1

if (has("nvim"))
    "For Neovim 0.1.3 and 0.1.4 < https://github.com/neovim/neovim/pull/2198 >
    let $NVIM_TUI_ENABLE_TRUE_COLOR=1
endif

"For Neovim > 0.1.5 and Vim > patch 7.4.1799 < https://github.com/vim/vim/commit/61be73bb0f965a895bfb064ea3e55476ac175162 >
"Based on Vim patch 7.4.1770 (`guicolors` option) < https://github.com/vim/vim/commit/8a633e3427b47286869aa4b96f2bfc1fe65b25cd >
" < https://github.com/neovim/neovim/wiki/Following-HEAD#20160511 >
if (has("termguicolors"))
    set termguicolors
endif

let g:everforest_background = 'hard'  " 可选：soft | medium | hard
let g:everforest_enable_italic = 1
let g:everforest_disable_italic_comment = 0
colorscheme everforest

"colorscheme catppuccin_mocha
"colorscheme rose-pine
"colorscheme monokai-soda

" -------------------vim-airline--------------------
let g:airline_theme='molokai'
let g:airline_powerline_fonts = 1


" -------------------nerdtree-----------------------
" nnoremap <leader>f :NERDTreeFind<CR>              " 定位到当前文件
let NERDTreeIgnore=['\.meta$']
let NERDTreeShowHidden=1
nnoremap <C-t> :NERDTreeMirror<CR>
" nerdtree-git-plugin
let g:NERDTreeGitStatusShowIgnored = 1

"let g:NERDTreeGitStatusUseNerdFonts = 1
let g:NERDTreeGitStatusShowClean = 1

" vim-tmux-navigator
let g:tmux_navigator_save_on_switch = 2

" ------------------vim-rainbow---------------------
let g:rainbow_active = 1

" -------------------EasyMotion---------------------
" Disable default mappings
let g:EasyMotion_do_mapping = 0
let g:EasyMotion_smartcase = 1                      " Turn on case-insensitive feature

map f <Plug>(easymotion-bd-f)
nmap f <Plug>(easymotion-overwin-f2)

map gl <Plug>(easymotion-bd-jk)
nmap gl <Plug>(easymotion-overwin-line)

map  W <Plug>(easymotion-bd-w)
nmap W <Plug>(easymotion-overwin-w)

map  / <Plug>(easymotion-sn)
nmap / <Plug>(easymotion-tn)

" These `n` & `N` mappings are options. You do not have to map `n` & `N` to EasyMotion.
" Without these mappings, `n` & `N` works fine. (These mappings just provide
" different highlight method and have some other features )
map  n <Plug>(easymotion-next)
map  N <Plug>(easymotion-prev)

" -------------------vim-startify---------------------
let g:startify_custom_header =
            \ startify#pad(split(system('figlet -f isometric1 Hello World'), '\n'))

" -----------------------rust-------------------------
let g:rustfmt_autosave=1

