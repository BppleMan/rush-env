"====================================================
"=                     键位映射                     =
"====================================================
nnoremap j gj
nnoremap k gk
" move to beginning/end of line
noremap B ^
noremap E $
" $/^ doesn't do anything
nnoremap $ <nop>
nnoremap ^ <nop>
inoremap jk <esc>
nnoremap <leader>v :tabnew ~/.vimrc<CR>
nnoremap <leader>z :tabnew ~/.zshrc<CR>
nnoremap <leader>sv :source ~/.vimrc<CR>
nnoremap <leader>sn :source ~/.config/nvim/init.vim<CR>

" 使用:set nohlsearch会导致当前的会话永久取消搜索高亮
" 使用:noh只会在取消此次搜索的高亮,下次搜索会自动启用hl
" 因此把Ctrl-C映射到[:noh回车],就能通过快捷键取消当前搜索的hl
nnoremap <nowait><silent> <C-c> :noh<CR>

nnoremap x "_x
nnoremap X "_X
nnoremap d "_d
nnoremap dd "_dd
nnoremap D "_D
vnoremap d "_d
vnoremap dd "_dd

"====================================================
"=                   自动命令                       =
"====================================================
let g:gutentags_enabled=0                           " 关掉烦人的gutentags: ctags job failed, returned: 1
if $TERM_PROGRAM =~ "iTerm"
    let &t_SI = "\<Esc>]50;CursorShape=1\x7"        " Vertical bar in insert mode
    let &t_EI = "\<Esc>]50;CursorShape=0\x7"        " Block in normal mode
endif

if has("autocmd")
    augroup manual
        autocmd!
        " 自动跳到上次打开的光标位置
        autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif

        " Start NERDTree and put the cursor back in the other window.
        autocmd VimEnter * NERDTreeMirror | wincmd p

        " Exit Vim if NERDTree is the only window remaining in the only tab.
        autocmd BufEnter * if tabpagenr('$') == 1 && winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree()
                    \ | call system('printf "\e[5 q" > $TTY')
                    \ | quit
                    \ | endif
        " Close the tab if NERDTree is the only window remaining in it.
        autocmd BufEnter * if winnr('$') == 1 && exists('b:NERDTree') && b:NERDTree.isTabTree()
                    \ | call system('printf "\e[5 q" > $TTY')
                    \ | quit
                    \ | endif
        " Open the existing NERDTree on each new tab.
        " autocmd BufWinEnter * if getcmdwintype() == '' | silent NERDTreeMirror | endif

        autocmd VimLeave * call system('printf "\e[5 q" > $TTY')
    augroup END

    augroup filetype
        autocmd!
        autocmd BufRead,BufNewFile *.swift set ft=swift
        autocmd FileType json syntax match Comment +\/\/.\+$+
    augroup END

    augroup VCenterCursor
    au!
    au BufEnter,WinEnter,WinNew,VimResized *,*.*
            \ let &scrolloff=winheight(win_getid())/2
    augroup END
endif
